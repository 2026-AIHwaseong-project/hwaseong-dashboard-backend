# ============================================================
# 화성시 버스 수요·공급 미스매칭 분석 — 환경변수
# 이 파일은 절대 git에 올리지 마세요 (.gitignore 등록됨)
# ============================================================

# ------------------------------------------------------------
# 공공데이터포털 인증키
#   마이페이지 > 오픈API > 인증키 발급현황 에서 확인
#   계정당 1개의 키를 모든 API에 공통으로 사용합니다.
#
# ⚠️ Encoding / Decoding 두 종류가 보일 텐데 둘 다 넣어두세요.
#    - requests에 params=dict 로 넘길 때  → DECODING 사용
#    - URL 문자열을 직접 만들 때           → ENCODING 사용
#    잘못 고르면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 납니다.
# ------------------------------------------------------------
DATA_GO_KR_KEY_DECODING=여기에_발급받은_키_붙여넣기
DATA_GO_KR_KEY_ENCODING=여기에_발급받은_키_붙여넣기


# ------------------------------------------------------------
# API 엔드포인트 (확인 완료 — 수정 불필요)
# ------------------------------------------------------------

# TAGO 버스노선정보 (15098529) — 노선별 경유 정류소
TAGO_ROUTE_BASE=https://apis.data.go.kr/1613000/BusRouteInfoInqireService

# TAGO 버스정류소정보 (15098534) — 정류소 마스터
TAGO_STOP_BASE=https://apis.data.go.kr/1613000/BusSttnInfoInqireService

# 경기도 버스노선 조회 (15080662) — 배차간격 + 경유정류소
#   /getBusRouteListv2         노선번호목록조회
#   /getBusRouteInfoItemv2     노선정보항목조회  ← 배차간격은 여기
#   /getBusRouteStationListv2  경유정류소목록조회
GG_BUS_ROUTE_BASE=https://apis.data.go.kr/6410000/busrouteservice/v2


# ------------------------------------------------------------
# 조회 파라미터
# ------------------------------------------------------------

# TAGO 도시코드 — 화성시. 첫 실행 시 반드시 검증하세요(아래 주의사항).
TAGO_CITY_CODE=31240

# 경기도 시군 코드 — 화성시
GG_SIGUN_CODE=41590

# 분석 대상 시군명 (CSV 필터용)
TARGET_SIGUN=화성시


# ------------------------------------------------------------
# 경로
# ------------------------------------------------------------
DATA_RAW_DIR=./dataset
DATA_INTERIM_DIR=./data/interim
DATA_OUT_DIR=./web/public/data


